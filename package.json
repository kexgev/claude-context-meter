{
  "name": "claude-usage-meter",
  "displayName": "Claude Usage Meter",
  "description": "Live Claude Code usage in your status bar — subscription session and weekly limits, context window, cost, burn rate, spend summaries, and budget alerts. Supports Claude Opus 5, Sonnet 5, Fable 5, Haiku 4.5, and every future Claude model automatically.",
  "version": "2.0.0",
  "publisher": "kexgev",
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "context window",
    "token usage",
    "cost tracker",
    "spend tracker",
    "budget alert",
    "status bar",
    "ai",
    "llm",
    "opus",
    "sonnet",
    "haiku",
    "usage",
    "rate limit",
    "subscription",
    "budget"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kexgev/claude-usage-meter"
  },
  "bugs": {
    "url": "https://github.com/kexgev/claude-usage-meter/issues"
  },
  "homepage": "https://github.com/kexgev/claude-usage-meter#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "configuration": {
      "title": "Claude Usage Meter",
      "properties": {
        "claudeUsageMeter.contextLimit": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "maximum": 2000000,
          "description": "Fallback token limit when model is not detected"
        },
        "claudeUsageMeter.idleTimeout": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 600,
          "description": "Seconds of inactivity before hiding a session"
        },
        "claudeUsageMeter.warningThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 99,
          "description": "Percentage at which status bar turns yellow"
        },
        "claudeUsageMeter.dangerThreshold": {
          "type": "number",
          "default": 75,
          "minimum": 2,
          "maximum": 100,
          "description": "Percentage at which status bar turns red"
        },
        "claudeUsageMeter.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Abbreviate project names in status bar"
        },
        "claudeUsageMeter.showEmoji": {
          "type": "boolean",
          "default": true,
          "description": "Show project emoji in status bar"
        },
        "claudeUsageMeter.autoColor": {
          "type": "boolean",
          "default": true,
          "description": "Auto-assign pastel colors per project"
        },
        "claudeUsageMeter.shortNames": {
          "type": "object",
          "default": {},
          "description": "Custom name overrides: { \"projectName\": \"abbr\" }"
        },
        "claudeUsageMeter.dailyBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Daily spend alert threshold in USD across all sessions (0 = disabled)"
        },
        "claudeUsageMeter.showUsage": {
          "type": "boolean",
          "default": true,
          "description": "Show Claude subscription usage (session and weekly limits) in the status bar"
        },
        "claudeUsageMeter.usageWarningThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 99,
          "description": "Subscription usage percentage at which the meter turns yellow"
        },
        "claudeUsageMeter.usageDangerThreshold": {
          "type": "number",
          "default": 75,
          "minimum": 2,
          "maximum": 100,
          "description": "Subscription usage percentage at which the meter turns red"
        },
        "claudeUsageMeter.usageStaleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "Minutes after which the cached usage reading is marked stale"
        },
        "claudeUsageMeter.usageLiveFetch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Fetch current subscription usage from Anthropic using the OAuth token Claude Code stores locally. This is the same request Claude Code makes for its own `/usage` command, and the token is sent only to Anthropic. Turn this off to avoid all network requests; usage then falls back to Claude Code’s local cache, which can be badly out of date."
        },
        "claudeUsageMeter.usageRefreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "Seconds between subscription usage refreshes. The endpoint rate-limits frequent polling, so avoid very low values."
        }
      }
    },
    "commands": [
      {
        "command": "claudeUsageMeter.hideSession",
        "title": "Hide Claude Session",
        "category": "Claude Usage Meter"
      },
      {
        "command": "claudeUsageMeter.copyStats",
        "title": "Copy Context Stats",
        "category": "Claude Usage Meter"
      },
      {
        "command": "claudeUsageMeter.showDetail",
        "title": "Show Session Detail",
        "category": "Claude Usage Meter"
      },
      {
        "command": "claudeUsageMeter.showSpendSummary",
        "title": "Show Spend Summary",
        "category": "Claude Usage Meter"
      },
      {
        "command": "claudeUsageMeter.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Claude Usage Meter"
      },
      {
        "command": "claudeUsageMeter.showUsageDetail",
        "title": "Show Subscription Usage",
        "category": "Claude Usage Meter"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js",
    "lint": "eslint src --ext .ts",
    "vsce:package": "vsce package"
  },
  "overrides": {
    "serialize-javascript": "7.0.4"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.0.0",
    "mocha": "^11.3.0",
    "typescript": "^5.0.0"
  }
}
