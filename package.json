{
  "name": "claude-context-meter",
  "displayName": "Claude Code Usage Meter",
  "description": "Live Claude Code usage in your status bar — subscription session and weekly limits, context window, cost, burn rate, spend summaries, and budget alerts. Supports Claude Opus 5, Sonnet 5, Fable 5, Haiku 4.5, and every future Claude model automatically.",
  "version": "2.0.0",
  "publisher": "kexgev",
  "keywords": [
    "claude",
    "claude code",
    "claude ai",
    "anthropic",
    "context window",
    "context meter",
    "usage meter",
    "token usage",
    "token counter",
    "token limit",
    "cost tracker",
    "spend tracker",
    "cost",
    "burn rate",
    "budget alert",
    "budget",
    "status bar",
    "monitor",
    "ai",
    "ai coding",
    "llm",
    "opus",
    "sonnet",
    "haiku",
    "fable",
    "usage",
    "rate limit",
    "session limit",
    "weekly limit",
    "subscription"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kexgev/claude-context-meter"
  },
  "bugs": {
    "url": "https://github.com/kexgev/claude-context-meter/issues"
  },
  "homepage": "https://github.com/kexgev/claude-context-meter#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "configuration": {
      "title": "Claude Code Usage Meter",
      "properties": {
        "claudeContextMeter.contextLimit": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "maximum": 2000000,
          "description": "Fallback token limit when model is not detected"
        },
        "claudeContextMeter.idleTimeout": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 600,
          "description": "Seconds of inactivity before hiding a session"
        },
        "claudeContextMeter.warningThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 99,
          "description": "Percentage at which status bar turns yellow"
        },
        "claudeContextMeter.dangerThreshold": {
          "type": "number",
          "default": 75,
          "minimum": 2,
          "maximum": 100,
          "description": "Percentage at which status bar turns red"
        },
        "claudeContextMeter.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Abbreviate project names in status bar"
        },
        "claudeContextMeter.showEmoji": {
          "type": "boolean",
          "default": true,
          "description": "Show project emoji in status bar"
        },
        "claudeContextMeter.autoColor": {
          "type": "boolean",
          "default": true,
          "description": "Auto-assign pastel colors per project"
        },
        "claudeContextMeter.shortNames": {
          "type": "object",
          "default": {},
          "description": "Custom name overrides: { \"projectName\": \"abbr\" }"
        },
        "claudeContextMeter.dailyBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Daily spend alert threshold in USD across all sessions (0 = disabled)"
        },
        "claudeContextMeter.showUsage": {
          "type": "boolean",
          "default": true,
          "description": "Show Claude subscription usage (session and weekly limits) in the status bar"
        },
        "claudeContextMeter.usageWarningThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 99,
          "description": "Subscription usage percentage at which the meter turns yellow"
        },
        "claudeContextMeter.usageDangerThreshold": {
          "type": "number",
          "default": 75,
          "minimum": 2,
          "maximum": 100,
          "description": "Subscription usage percentage at which the meter turns red"
        },
        "claudeContextMeter.usageStaleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "Minutes after which the cached usage reading is marked stale"
        },
        "claudeContextMeter.usageLiveFetch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Fetch current subscription usage from Anthropic using the OAuth token Claude Code stores locally. This is the same request Claude Code makes for its own `/usage` command, and the token is sent only to Anthropic. Turn this off to avoid all network requests; usage then falls back to Claude Code’s local cache, which can be badly out of date."
        },
        "claudeContextMeter.usageRefreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "Seconds between subscription usage refreshes. The endpoint rate-limits frequent polling, so avoid very low values."
        }
      }
    },
    "commands": [
      {
        "command": "claudeContextMeter.hideSession",
        "title": "Hide Claude Session",
        "category": "Claude Code Usage Meter"
      },
      {
        "command": "claudeContextMeter.copyStats",
        "title": "Copy Context Stats",
        "category": "Claude Code Usage Meter"
      },
      {
        "command": "claudeContextMeter.showDetail",
        "title": "Show Session Detail",
        "category": "Claude Code Usage Meter"
      },
      {
        "command": "claudeContextMeter.showSpendSummary",
        "title": "Show Spend Summary",
        "category": "Claude Code Usage Meter"
      },
      {
        "command": "claudeContextMeter.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Claude Code Usage Meter"
      },
      {
        "command": "claudeContextMeter.showUsageDetail",
        "title": "Show Subscription Usage",
        "category": "Claude Code Usage Meter"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js",
    "lint": "eslint src --ext .ts",
    "vsce:package": "vsce package"
  },
  "overrides": {
    "serialize-javascript": "7.0.4"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.0.0",
    "mocha": "^11.3.0",
    "typescript": "^5.0.0"
  }
}
